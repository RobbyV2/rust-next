{
  "name": "rust-next",
  "description": "Rust + Next.js full-stack template with WASM support",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "bun .next/standalone/server.js",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mjs}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mjs}\""
  },
  "dependencies": {
    "next": "^16.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22.19.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.0",
    "typescript-eslint": "^8.56.0"
  }
}
